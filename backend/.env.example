DATABASE_URL=postgresql://username:password@localhost:5432/newshop_db
SECRET_KEY=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
CCTV_AUTHORIZED_USER_IDS=
# Comma-separated allowed CORS origins (no trailing slash, no wildcards in production)
CORS_ORIGINS=http://localhost:3000,http://stock.localhost:3000,http://sales.localhost:3000,http://admin.localhost:3000